# ── Database (Railway MySQL) ────────────────────────────────────
# انسخ قيمة DATABASE_URL من خدمة MySQL في Railway
DATABASE_URL=mysql://root:password@host:port/railway

# ── Auth (Backend) ──────────────────────────────────────────────
# مفتاح توقيع جلسات JWT — ولّده مثلاً بـ: openssl rand -hex 32
JWT_SECRET=

# ── Telegram Login ──────────────────────────────────────────────
# توكن البوت من @BotFather — يُستخدم للتحقق من بيانات Telegram Login Widget
TELEGRAM_BOT_TOKEN=
# اسم مستخدم البوت (بدون @) — يظهر زر دخول تليجرام فقط عند ضبطه
TELEGRAM_BOT_USERNAME=
# نفس القيمة للـ frontend (Vite يمرر متغيرات VITE_* فقط)
VITE_TELEGRAM_BOT_USERNAME=

# ── Google OAuth (اختياري — زر جوجل يظهر فقط عند ضبطهما) ────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Admin ───────────────────────────────────────────────────────
# إيميلات تُمنح role=admin تلقائياً عند التسجيل، مفصولة بفواصل
ADMIN_EMAILS=you@zekospace.com

# ── ربط حسابات تليجرام (اختياري) ────────────────────────────────
# لو ضُبط، يجب أن يرسل البوت الخارجي نفس القيمة في ترويسة x-link-secret
LINK_API_SECRET=

# ── Site ────────────────────────────────────────────────────────
# الدومين الكامل للموقع (يُستخدم في Google OAuth redirect URI)
SITE_URL=https://zekospace.com
PORT=3000

# ── السكرابرز / محرك البيانات ───────────────────────────────────
# المصادر المفعّلة (مفصولة بفواصل). mangadar معطّل افتراضياً (Cloudflare)
ENABLED_SOURCES=kawaiimanga,olympustaff,azorafly,mangatime,rocksmanga,3asq,despair
# كل كم دقيقة تُحدَّث الفصول من المصادر (refreshAll)
SCRAPER_REFRESH_MIN=30
# استيراد تلقائي عند الإقلاع لو كانت قاعدة البيانات فارغة
IMPORT_ON_EMPTY=true
# عدد السلاسل المستوردة لكل مصدر في الاستيراد الأولي
IMPORT_LIMIT_PER_SOURCE=12
# فعّل مصدر mangadar بتوفير FlareSolverr (اختياري)
# FLARESOLVERR_URL=
# مفتاح API لـ kawaiimanga (الافتراضي مدمج ويُحدَّث تلقائياً عند رفضه)
# KAWAII_APP_KEY=

# ── البريد (توثيق الإيميل — اختياري) ────────────────────────────
# رابط SMTP بصيغة smtp://user:pass@host:port أو smtps://...
# لو غير مضبوط يُسجَّل الكود في اللوج ويُعاد كـ devCode خارج الإنتاج
SMTP_URL=
